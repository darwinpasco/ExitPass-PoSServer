# Copy this file outside the repository and supply it with --env-file.
# Values are non-secret examples. Paths should be absolute Windows paths accepted by Docker Desktop.

COMPOSE_PROJECT_NAME=exitpass-posserver
ASPNETCORE_ENVIRONMENT=Production
# Replace with the reviewed full commit ID that the API image was built from.
POSSERVER_SOURCE_REVISION=0000000000000000000000000000000000000000

# Reviewed base-image indexes are immutable. Replace the two application-image placeholders with
# approved registry digest references after the release images are built and scanned.
POSTGRES_IMAGE=postgres@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk@sha256:ec9c0a0dc5f60adc2065762050638dd5ed5facfc53716d4580a42d86027c8e80
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet@sha256:a3cd573ac05cf88ca496e3309cb7f7c44aa16664352d1ee41eda93154f50cdbf
POSSERVER_API_IMAGE=replace-with-approved-api-image-digest
POSSERVER_BACKUP_IMAGE=replace-with-approved-backup-image-digest
GOOGLE_CLOUD_CLI_VERSION=588.0.0-0

POSSERVER_DB_NAME=posserver
POS_REQUIRE_COMPLETE_SALES_INVOICE_HEADER_PROFILE=true

# Loopback is the safe default for review. An approved deployment may bind a LAN address after firewall review.
POSSERVER_HTTPS_BIND_ADDRESS=127.0.0.1
POSSERVER_HTTPS_PORT=8443
POSSERVER_APP_CONFIG_FILE=C:/ExitPass/Runtime/config/appsettings.Production.json
POSSERVER_TLS_CERT_FILE=C:/ExitPass/Runtime/tls/posserver.crt
POSSERVER_TLS_KEY_FILE=C:/ExitPass/Runtime/tls/posserver.key

# Each file must contain one externally generated value and must remain outside Git.
POSSERVER_POSTGRES_BOOTSTRAP_PASSWORD_FILE=C:/ExitPass/Runtime/secrets/postgres-bootstrap-password.txt
POSSERVER_POSTGRES_ADMIN_PASSWORD_FILE=C:/ExitPass/Runtime/secrets/postgres-admin-password.txt
POSSERVER_POSTGRES_APP_PASSWORD_FILE=C:/ExitPass/Runtime/secrets/postgres-app-password.txt
POSSERVER_POSTGRES_BACKUP_PASSWORD_FILE=C:/ExitPass/Runtime/secrets/postgres-backup-password.txt

# Approved staging GCS values. GCS_PREFIX must be replaced with the site-specific prefix approved
# for this installation; this repository does not define the canonical site identifier.
GCP_PROJECT_ID=exitpass-staging
GCP_BACKUP_SERVICE_ACCOUNT_EMAIL=exitpass-pos-backup@exitpass-staging.iam.gserviceaccount.com
GCP_RESTORE_SERVICE_ACCOUNT_EMAIL=exitpass-pos-restore@exitpass-staging.iam.gserviceaccount.com
# SID of the designated Windows deployment operator allowed to read the credential file.
POSSERVER_WINDOWS_DEPLOYMENT_OPERATOR_SID=replace-with-designated-operator-sid
# The backup credential must have bucket-scoped roles/storage.objectCreator only.
POSSERVER_GCP_BACKUP_CREDENTIALS_FILE=C:/ExitPass/Runtime/secrets/gcs-backup-adc.json
POSSERVER_BACKUP_AGE_RECIPIENT_FILE=C:/ExitPass/Runtime/config/backup-age-recipient.txt
GCS_BUCKET=exitpass-staging-pos-backups
GCS_PREFIX=replace-with-approved-site-prefix
GCS_EXPECTED_LOCATION=asia-southeast1
GCS_STORAGE_CLASS=STANDARD

# Provisional controlled-demonstration targets; production values still require approval.
BACKUP_INTERVAL_SECONDS=3600
BACKUP_START_DELAY_SECONDS=300
BACKUP_HEALTH_GRACE_SECONDS=900
BACKUP_RPO_TARGET_SECONDS=3600
RESTORE_RTO_TARGET_SECONDS=14400
# No pruning is implemented. Record the approved value here after Records/Compliance approval.
BACKUP_RETENTION_DAYS=UNAPPROVED

POSSERVER_PGDATA_VOLUME=exitpass_pos_pgdata
POSSERVER_ANNEX_VOLUME=exitpass_pos_annex_e1
POSSERVER_BACKUP_STAGING_VOLUME=exitpass_pos_backup_staging
POSSERVER_BACKUP_STATUS_VOLUME=exitpass_pos_backup_status

POSTGRES_MEMORY_LIMIT=4g
POSTGRES_CPU_LIMIT=4.0
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=2.0
BACKUP_MEMORY_LIMIT=1g
BACKUP_CPU_LIMIT=1.0
BACKUP_TMPFS_SIZE=512m
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5
